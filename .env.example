# Run python scripts/setup.py to generate local secrets. Never commit .env.
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
POSTGRES_PASSWORD=
# For a managed service, use its internal or TLS-enabled PostgreSQL connection string.
# PostgreSQL URLs are normalized to the pinned psycopg driver automatically.
DATABASE_URL=
CORS_ORIGINS=http://localhost:8000,http://localhost:4173,http://localhost:5173
STORAGE_PATH=/app/storage
ENABLE_PUBLIC_DEMO_SESSIONS=true
APP_ENV=development
# Optional durable S3-compatible private bucket. Leave empty to use persistent disk.
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# Frontend build-time only; Docker uses same-origin /api.
VITE_API_BASE_URL=
